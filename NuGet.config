<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSourceMapping>
	<packageSource key="nuget">
	  <package pattern="*" />
	</packageSource>
	<packageSource key="THI-NuGet">
	  <package pattern="CHI.*" />
	  <package pattern="THI.*" />
	</packageSource>
  </packageSourceMapping>
</configuration>
